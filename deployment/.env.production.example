# ==============================================================================
# HalluGuard Production Environment Configuration (.env)
# ==============================================================================
# Deploy this file to: /opt/halluguard/HalluGuard/backend/.env
# Permissions should be set to 600: chmod 600 /opt/halluguard/HalluGuard/backend/.env
# Owned by: chown halluguard:halluguard /opt/halluguard/HalluGuard/backend/.env

# Application Server Settings
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# LettuceDetect Detection Engine Configuration
# Supported models:
#   - KRLabsOrg/lettucedect-base-modernbert-en-v1 (Default, fast ModernBERT encoder)
MODEL_PATH=KRLabsOrg/lettucedect-base-modernbert-en-v1
DETECTOR_METHOD=transformer
DEVICE=cpu
MAX_LENGTH=4096

# Hugging Face Persistent Cache Directory
# Keeps the 600 MB ModernBERT weights permanently resident on the 30 GB VM persistent disk
HF_HOME=/opt/halluguard/cache/huggingface

# Supabase PostgreSQL Configuration (Optional)
# If left blank, HalluGuard operates in session memory mode without errors.
# Documents and verifications will be stored in RAM and reset upon service restart.
# To enable permanent persistence across reboots, supply your Supabase project credentials:
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

