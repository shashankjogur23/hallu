# ==============================================================================
# HalluGuard Backend Environment Configuration
# ==============================================================================
# Copy this file to .env in backend/ and set your specific values.

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LettuceDetect Detection Engine Configuration
# Supported models:
#   - KRLabsOrg/lettucedect-base-modernbert-en-v1 (Default, fast ModernBERT encoder)
#   - KRLabsOrg/lettucedect-large-modernbert-en-v1
MODEL_PATH=KRLabsOrg/lettucedect-base-modernbert-en-v1
DETECTOR_METHOD=transformer
DEVICE=cpu
MAX_LENGTH=4096

# Supabase PostgreSQL Configuration
# Obtain these from your Supabase Dashboard: Settings -> API
# NOTE: The backend uses the service_role key to bypass RLS for server-side persistence.
# Never expose the service_role key in frontend code or public repositories.
# If left blank or untouched, the backend operates in local-only mode without blocking verification.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

